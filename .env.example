# Local runtime configuration template.
# Copy this file to .env and fill in real values for your environment.

RTSP_URL=rtsp://<user>:<pass>@<ip>:<port>/stream1
RTSP_URL_2=rtsp://<user>:<pass>@<ip>:<port>/stream1

OLLAMA_VISION_MODEL=qwen3-vl:4b
OLLAMA_REASONING_MODEL=qwen2.5:7b

ALIBABA_VISION_MODEL=qwen3-vl-8b-thinking
ALIBABA_REASONING_MODEL=qwen2.5-7b-instruct

INFER_INTERVAL=2.0
KB_SIMILARITY_THRESHOLD=0.3
KB_RETRIEVAL_TOP_K=3
ALARM_CONFIDENCE_THRESHOLD=0.6
LOG_LEVEL=INFO
DEBUG=False
ALIBABA_CLOUD_API_KEY=<your-alibaba-cloud-api-key>
OPENAI_API_KEY=<your-openai-api-key>
KB_ROOT=d:/code/python/git/Multi-camera/kb
KB_INDEX_DIR=d:/code/python/git/Multi-camera/kb/index
KB_CASES_DIR=d:/code/python/git/Multi-camera/kb/cases
KB_EMBED_MODEL_PATH=d:/code/python/git/Multi-camera/bge-small-zh-v1.5
KB_INDEX_UPDATE_THRESHOLD=1
MAX_CONCURRENT_INFERENCES=4
RTSP_TIMEOUT=1000000
OLLAMA_TIMEOUT=60
